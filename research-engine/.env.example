# ScholarForge Research Engine 环境变量
# 复制为 .env 后填写

# 服务监听端口
RESEARCH_ENGINE_PORT=8100

# 运行模式：paperqa（完整，需装 paper-qa）| builtin（轻量降级）
# 留空则自动探测：已安装 paper-qa 时用 paperqa，否则 builtin
RESEARCH_ENGINE_MODE=

# LLM 配置（paperqa 模式用于上下文摘要/问答；OpenAI 兼容接口）
# 与 ScholarForge 主后端可复用同一套 DeepSeek/Qwen 等模型 Key
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 嵌入模型（paperqa 模式；默认用本地 FlagEmbedding/BGE，也可指向 OpenAI 兼容嵌入接口）
EMBEDDING_MODEL=

# 可选鉴权：设置后，所有请求需携带 X-Api-Key 头
RESEARCH_ENGINE_API_KEY=
