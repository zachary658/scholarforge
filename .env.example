# ScholarForge 环境变量示例（复制为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交）
# ===== 必填（生产环境 NODE_ENV=production）=====
NODE_ENV=production
PORT=3001

# JWT 签名密钥：必须 >= 32 字符，且不含 your-jwt-secret / changeme 等占位词
JWT_SECRET=请替换为至少32位随机字符串例如$(openssl rand -hex 32)
# 可选：敏感配置保险箱独立根密钥；未设置时从 JWT_SECRET 派生。设置后不得随意更换
CONFIG_ENCRYPTION_KEY=
# 可选：审计日志 HMAC 独立根密钥；未设置时从 CONFIG_ENCRYPTION_KEY/JWT_SECRET 派生。设置后不得更换
AUDIT_HMAC_KEY=
# 后台双因素认证密钥加密（必须独立生成并长期安全保存；更换会导致现有 TOTP 失效）
TOTP_ENCRYPTION_KEY=请替换为另一段至少32位随机字符串

# 初始管理员账号（仅在数据库无管理员时用于引导）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=请设置至少8位且含字母与数字的强密码

# ===== 支付（production 下必须配置真实通道，否则服务拒绝启动）=====
# 可选值：mock（仅开发）/ alipay / wechat / mixed
PAYMENT_MODE=mock
# 支付宝（按需填写）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=
# 微信支付（按需填写）
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_CERT_PATH=

# ===== 可选 =====
# AI 模型：可在管理后台的加密保险箱配置；环境变量优先且不能被后台覆盖。
# 至少填一个才能真实生成；建议填两个以上不同服务商以启用多模型协作。
LLM_API_KEY_DEEPSEEK=
LLM_API_KEY_QWEN=
LLM_API_KEY_ZHIPU=
LLM_API_KEY_KIMI=
LLM_API_KEY_OPENAI=
# 可选运行时覆盖（五个 KEY 均支持），适用于模型升级或 OpenAI 兼容网关：
# LLM_BASE_URL_OPENAI=https://api.openai.com/v1
# LLM_MODEL_OPENAI=<你的可用模型名>
# 文献解析（MinerU）
MINERU_API_URL=
# 邮件（也可在管理后台“系统设置 → 邮件验证服务”配置；环境变量优先）
SMTP_URL=
MAIL_FROM=no-reply@example.com
# 留空可在管理后台配置；若在此填写，后台只读且以此值为准
FRONTEND_URL=
# CORS 白名单（逗号分隔）
CORS_ALLOW_ORIGINS=http://localhost:3001
# 反向代理层数（Nginx/网关后设为 1）
TRUST_PROXY=1
# 错误告警 webhook（可选，接收通用 JSON；4 秒超时、同类错误默认 60 秒内去重）
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=4000
ALERT_WEBHOOK_COOLDOWN_MS=60000
# 自动在线备份（生产默认启用；Docker 写入独立 sf-backups 卷）
BACKUP_ENABLED=true
BACKUP_DIR=/app/server/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
# 并发与成本（见 ai-service / paper-distillation）
AI_MAX_CONCURRENCY=8
AI_MAX_OUTPUT_TOKENS=16000
PDF_MAX_CONCURRENCY=5

# ===== 段落级学术 RAG / 出版级导出（可选插件，未配置则静默降级）=====
# Qdrant 向量库（稠密+稀疏混合检索 + BGE-M3 + reranker）
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=scholarforge_evidence
# 嵌入与重排（可选，缺失时回退本地 BM25）
BGE_M3_API_URL=
BGE_M3_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_API_URL=
RERANKER_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 全文结构与引用解析（Docling / GROBID，可选）
DOCLING_API_URL=
GROBID_API_URL=
# PaperQA2 研究引擎（独立 Python 服务，可选；见 research-engine/README.md）
PAPERQA_API_URL=
PAPERQA_API_KEY=
# Docker 可选研究服务：requirements.txt（轻量）或 requirements-full.txt（PaperQA2）
RESEARCH_REQUIREMENTS=requirements.txt
RESEARCH_ENGINE_MODE=
RESEARCH_ENGINE_PORT=8100
# 深度调研节点状态机（题目分析→检索→全文富集→蒸馏→待确认大纲）
RESEARCH_GRAPH_ENABLED=false
# 参考文献：CSL 样式（默认内置官方 GB/T 7714-2015 数字制，可切换为 apa/vancouver/harvard1 或本地 .csl 路径）
CSL_STYLE=
# Zotero Translation Server（文献导入，可选）
ZOTERO_TRANSLATION_URL=
ZOTERO_TRANSLATION_TIMEOUT_MS=30000
# 出版级导出（Quarto 优先，回退 Pandoc；二者都未配置则走内置 docx-generator）
QUARTO_BIN=
PANDOC_BIN=
QUARTO_TIMEOUT_MS=120000
