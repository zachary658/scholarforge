# ScholarForge 环境变量示例（复制为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交）
# ===== 必填（生产环境 NODE_ENV=production）=====
NODE_ENV=production
PORT=3001

# JWT 签名密钥：必须 >= 32 字符，且不含 your-jwt-secret / changeme 等占位词
JWT_SECRET=请替换为至少32位随机字符串例如$(openssl rand -hex 32)

# 初始管理员账号（仅在数据库无管理员时用于引导）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=请设置至少8位且含字母与数字的强密码

# ===== 支付（production 下必须配置真实通道，否则服务拒绝启动）=====
# 可选值：mock（仅开发）/ alipay / wechat / mixed
PAYMENT_MODE=mock
# 支付宝（按需填写）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=
# 微信支付（按需填写）
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_CERT_PATH=

# ===== 可选 =====
# AI 模型（在管理后台配置或在此注入环境变量，参考 model-catalog.js 的 env_key）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# 文献解析（MinerU）
MINERU_API_URL=
# 邮件
SMTP_URL=
MAIL_FROM=no-reply@example.com
FRONTEND_URL=http://localhost:3001
# CORS 白名单（逗号分隔）
CORS_ALLOW_ORIGINS=http://localhost:3001
# 反向代理层数（Nginx/网关后设为 1）
TRUST_PROXY=1
# 并发与成本（见 ai-service / paper-distillation）
AI_MAX_CONCURRENCY=8
AI_MAX_OUTPUT_TOKENS=16000
PDF_MAX_CONCURRENCY=5
