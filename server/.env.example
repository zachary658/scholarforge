# ScholarForge 环境变量配置
# 复制本文件为 .env 并填写真实值

# 服务端口
PORT=3001

# 运行环境
NODE_ENV=development

# 前端地址
FRONTEND_URL=http://localhost:5173

# CORS 允许的来源（多个用逗号分隔）
CORS_ALLOW_ORIGINS=http://localhost:5173

# 反向代理信任层数（部署在 Nginx/网关后时设置，如 1；直接暴露则留空或删除）
# 影响 req.ip 的获取（用于登录/注册速率限制与注册风控）；未设置时所有请求会共享代理 IP
TRUST_PROXY=

# JWT 密钥（必须填写强随机值（至少32字符））
JWT_SECRET=

# 管理员账号（首次启动自动创建）
ADMIN_EMAIL=admin@scholarforge.com
ADMIN_PASSWORD=

# ===== AI 模型 API Key（必配，用于真实模型调用）=====
# 安全设计：API Key 只通过环境变量注入，不存入数据库、不返回前端。
# 每个模型的 Key 对应一个环境变量（见 server/src/model-catalog.js），
# 在管理后台「模型配置」页选择默认模型，未配置 Key 时自动回退内置模板引擎。
LLM_API_KEY_DEEPSEEK=
LLM_API_KEY_QWEN=
LLM_API_KEY_ZHIPU=
LLM_API_KEY_KIMI=
LLM_API_KEY_OPENAI=
# 新增模型：在 model-catalog.js 追加预设 + 添加对应的 LLM_API_KEY_XXX 环境变量即可

# ===== MinerU 文档解析（可选，高质量 PDF 表格/公式/双栏解析通道）=====
# 部署 MinerU API（https://github.com/opendatalab/MinerU，官方提供 FastAPI 服务）后填写。
# 留空则使用内置 pdfjs 轻量解析（零依赖兜底，质量低于 MinerU）。
# 数据套用引擎会优先走 MinerU 提取表格/指标，失败自动回退 pdfjs。
MINERU_API_URL=
MINERU_TIMEOUT=60000

# ===== 中文文献 MCP 通道（可选插件，默认禁用）=====
# 通过 MCP 协议连接 cnki-mcp（https://github.com/wuruiqi/cnki-mcp）等外部文献检索服务，
# 补全知网中文文献。命令由部署方安装（如 uvx cnki-mcp），留空则跳过该源。
# 合规提示：知网检索依赖登录态与浏览器自动化，商用前请确认知网服务条款。
CNKI_MCP_COMMAND=
# 命令参数：JSON 数组（推荐，支持带空格参数）或空格分隔字符串
CNKI_MCP_ARGS=
CNKI_MCP_TIMEOUT=45000

# 支付在管理后台配置，无需在此设置环境变量

# ===== 邮件配置（可选，用于注册验证码）=====
SMTP_URL=smtps://user:pass@host:465
MAIL_FROM=ScholarForge <noreply@example.com>